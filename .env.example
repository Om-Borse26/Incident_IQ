# .env.example
# Copy this file to .env and fill in the values.

# Ordered comma-separated list of providers to try. First one is primary;
# subsequent ones are fallbacks used if the primary fails.
LLM_FALLBACK_ORDER=groq,gemini

# Groq — obtain your key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — obtain your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=incidentiq

# ─── Google Cloud Pub/Sub (Phase 11: Async Ingestion Pipeline) ───────────────
# GCP project ID. "local-dev" is a placeholder used by the Pub/Sub emulator.
# In production (real GCP), set this to your actual GCP project ID.
GCP_PROJECT_ID=local-dev

# Pub/Sub emulator address for local development and docker-compose.
# The docker-compose.yml sets this automatically for the api + worker services.
# ✅ LOCAL DEV:       PUBSUB_EMULATOR_HOST=localhost:8085
# ✅ DOCKER-COMPOSE:  PUBSUB_EMULATOR_HOST=pubsub-emulator:8085  (set in compose)
# ✅ REAL GCP:        Leave this blank (or remove entirely). SDK uses ADC credentials.
PUBSUB_EMULATOR_HOST=localhost:8085
