# .env.example
# Copy this file to .env and fill in the values.

# Ordered comma-separated list of providers to try. First one is primary;
# subsequent ones are fallbacks used if the primary fails.
LLM_FALLBACK_ORDER=groq,gemini

# Groq — obtain your key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — obtain your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Validator specific key (can be same as GROQ_API_KEY)
GROQ_VALIDATOR_API_KEY=

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=incidentiq

# ─── AWS Configuration (SQS Messaging + ECR) ─────────────────────────────────
# Region where your SQS queues and ECR repo are hosted.
AWS_REGION=ap-south-1

# IAM credentials — create a user with AmazonSQSFullAccess +
# AmazonEC2ContainerRegistryFullAccess + AmazonEC2FullAccess policies.
# Go to: IAM → Users → <username> → Security credentials → Create access key (CLI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Data Directory ───────────────────────────────────────────────────────────
# On EC2: /data (host-mounted root EBS directory via docker -v /home/ec2-user/data:/data)
# Locally: leave unset (defaults to "." in config.py) or set to ./data
DATA_DIR=/data
